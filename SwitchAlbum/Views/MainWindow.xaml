<Window x:Class="SwitchAlbum.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:SwitchAlbum.Resources"
        xmlns:controls="clr-namespace:SwitchAlbum.Controls"
        xmlns:views="clr-namespace:SwitchAlbum.Views"
        xmlns:vm="clr-namespace:SwitchAlbum.ViewModels"
        xmlns:conv="clr-namespace:SwitchAlbum.Converters"
        Title="{x:Static res:Strings.App_Title}"
        Width="1280" Height="800" MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate DataType="{x:Type vm:GameWallViewModel}">
            <views:GameWallView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameGridViewModel}">
            <views:GameGridView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶栏 ============ -->
        <Border Grid.Row="0" Background="{DynamicResource TopBarBackgroundBrush}" Padding="18,11"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static res:Strings.App_Title}" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <!-- 设备状态 -->
                    <Border Margin="14,0,0,0" CornerRadius="11" Padding="12,5"
                            Background="{DynamicResource ChipBackgroundBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource DeviceDotOffBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource DeviceDotBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="7,0,0,0" Text="{Binding DeviceStatusText}" FontSize="12.5"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static res:Strings.Lbl_SavePath}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding SavePathText}" VerticalAlignment="Center" MaxWidth="230"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SavePathText}"/>
                    <Button Content="{x:Static res:Strings.Btn_ChangePath}" Command="{Binding ChangeSavePathCommand}"
                            Style="{StaticResource SubtleButtonStyle}" Margin="8,0,0,0" Padding="10,5" FontSize="12"/>

                    <Rectangle Width="1" Height="22" Fill="{DynamicResource BorderBrush}" Margin="16,0"/>

                    <Button Content="{x:Static res:Strings.Btn_Rescan}" Command="{Binding RescanCommand}"
                            Style="{StaticResource SubtleButtonStyle}"/>
                    <Button Content="{x:Static res:Strings.Btn_SaveAll}" Command="{Binding SaveAllCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0"/>
                    <Button Content="{x:Static res:Strings.Btn_SaveToPhone}" Command="{Binding SaveAllToPhoneCommand}"
                            Style="{StaticResource AccentOutlineButtonStyle}" Margin="10,0,0,0"/>
                    <Button Content="{x:Static res:Strings.Btn_Settings}" Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource SubtleButtonStyle}" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 内容区 ============ -->
        <Grid Grid.Row="1">
            <controls:TransitionHost x:Name="ContentHost" Content="{Binding CurrentContent}"/>

            <!-- 空状态提示 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640"
                        Visibility="{Binding HintVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding HintText}" TextWrapping="Wrap" TextAlignment="Center" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="24"/>
                <Button Content="{x:Static res:Strings.Btn_TryMock}" Command="{Binding TryMockCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Margin="0,20,0,0"
                        Visibility="{Binding TryMockVisible, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- ============ 灯箱浮层 ============ -->
            <Grid Background="{DynamicResource OverlayBrush}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Lightbox}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                             Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Button Content="‹" Command="{Binding Lightbox.PrevCommand}" IsEnabled="{Binding Lightbox.CanPrev}"
                        Style="{StaticResource LightboxButtonStyle}" FontSize="52" Width="72" Height="120"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button Content="›" Command="{Binding Lightbox.NextCommand}" IsEnabled="{Binding Lightbox.CanNext}"
                        Style="{StaticResource LightboxButtonStyle}" FontSize="52" Width="72" Height="120"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="×" Command="{Binding Lightbox.CloseCommand}"
                        Style="{StaticResource LightboxButtonStyle}" FontSize="26" Width="46" Height="46"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"/>

                <Grid Margin="96,40,96,88">
                    <Image x:Name="LightboxImage" Source="{Binding Lightbox.FullPath}" Stretch="Uniform"/>

                    <!-- 视频占位 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Lightbox.Current.IsVideo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{x:Static res:Strings.Lightbox_NoPreview}" Foreground="#CCFFFFFF"
                                   FontSize="14" HorizontalAlignment="Center"/>
                        <Button Content="{x:Static res:Strings.Btn_OpenVideo}" Command="{Binding Lightbox.OpenVideoCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 底部信息条 -->
                <Border Background="#66000000" CornerRadius="10" Padding="16,8"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Lightbox.IndexText}" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="  ·  " Foreground="#99FFFFFF" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lightbox.CaptionText}" Foreground="#DDFFFFFF" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="2" Background="{DynamicResource TopBarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 轻提示 -->
                <Border CornerRadius="10" Background="{DynamicResource ToastBackgroundBrush}" Padding="14,7"
                        VerticalAlignment="Center" HorizontalAlignment="Left"
                        Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ToastText}" Foreground="White" FontSize="12.5"/>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ProgressBar Width="220" Style="{StaticResource ThinProgressBarStyle}"
                                 Value="{Binding ProgressValue}" IsIndeterminate="{Binding ProgressIndeterminate}"
                                 Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}"/>
                    <ProgressBar Width="220" Style="{StaticResource ThinProgressBarStyle}" IsIndeterminate="True"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{x:Static res:Strings.Btn_Cancel}" Command="{Binding CancelTransferCommand}"
                            Style="{StaticResource SubtleButtonStyle}" Margin="12,0,0,0" Padding="10,5" FontSize="12"
                            Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
