<Window x:Class="SwitchAlbum.Views.DevicePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:SwitchAlbum.Resources"
        Title="{x:Static res:Strings.Phone_Picker_Title}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="24,20">
        <TextBlock Text="{x:Static res:Strings.Phone_Picker_Title}" FontSize="15" FontWeight="SemiBold"/>
        <ListBox x:Name="DeviceList" Margin="0,14,0,0" Height="200"
                 Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                 DisplayMemberPath="FriendlyName" SelectionChanged="DeviceList_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="12,9"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <TextBlock Text="{x:Static res:Strings.Phone_None}" Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,14,0,0" x:Name="NoneHint" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{x:Static res:Strings.Common_Cancel}" Click="Cancel_Click"
                    Style="{StaticResource SubtleButtonStyle}" MinWidth="84"/>
            <Button Content="{x:Static res:Strings.Common_Ok}" Click="Ok_Click"
                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="84" Margin="10,0,0,0" x:Name="OkButton"/>
        </StackPanel>
    </StackPanel>
</Window>
