<UserControl x:Class="SwitchAlbum.Controls.PhotoCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:SwitchAlbum.Resources"
             xmlns:conv="clr-namespace:SwitchAlbum.Converters"
             Width="212" Height="186">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Border x:Name="Root" Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            ClipToBounds="True" Cursor="Hand"
            MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" CenterX="106" CenterY="93"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="132"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 缩略图 -->
            <Grid Grid.Row="0">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E8EAED" Offset="0"/>
                            <GradientStop Color="#CDD2D9" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Image Source="{Binding ThumbPath}" Stretch="UniformToFill"/>

                <!-- 视频徽标 -->
                <Border Background="#99000000" CornerRadius="8" Padding="8,3" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="6"
                        Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{x:Static res:Strings.Badge_Video}" Foreground="White" FontSize="11"/>
                </Border>

                <!-- 勾选 -->
                <CheckBox x:Name="SelectBox" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                          Style="{StaticResource PhotoCheckBoxStyle}"/>
            </Grid>

            <!-- 信息行 -->
            <Grid Grid.Row="1" Margin="10,5,10,7">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DateText}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Text="{x:Static res:Strings.Badge_Saved}" FontSize="10.5"
                           Foreground="{DynamicResource SuccessBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Visibility="{Binding SavedVisible, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
